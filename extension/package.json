{
  "name": "tiangz-native-language",
  "displayName": "TiangZ Native Language",
  "description": "为 TiangZ .native Entity 与 Native op schema 提供中文语言支持",
  "version": "0.14.0",
  "publisher": "moulo",
  "author": "moulo",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
  ],
  "main": "./dist/extension.cjs",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "TiangZ",
    "native",
    "entity",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/moulo1982Google/tiangz-native-language.git"
  },
  "files": [
    "language-configuration.json",
    "syntaxes/**",
    "snippets/**",
    "dist/extension.cjs",
    "dist/extension.cjs.map",
    "dist/server.cjs",
    "dist/server.cjs.map",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../tools/build-extension.mjs",
    "check:package": "vsce ls --no-dependencies",
    "prepackage": "node -e \"require('node:fs').mkdirSync('../dist', { recursive: true })\"",
    "package": "npm run build && vsce package --no-dependencies --out ../dist/tiangz-native-language-0.14.0.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.6.2",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "contributes": {
    "languages": [
      {
        "id": "tiangz-native",
        "aliases": [
          "TiangZ Native",
          "tiangz-native"
        ],
        "extensions": [
          ".native"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tiangz-native",
        "scopeName": "source.tiangz-native",
        "path": "./syntaxes/tiangz-native.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tiangz-native",
        "path": "./snippets/tiangz-native.json"
      }
    ],
    "commands": [
      {
        "command": "tiangzNative.showServerStats",
        "title": "TiangZ Native：显示语言服务器状态"
      },
      {
        "command": "tiangzNative.runCodegen",
        "title": "TiangZ Native：运行代码生成"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tiangzNative.runCodegen",
          "when": "editorLangId == tiangz-native",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "TiangZ Native",
      "properties": {
        "tiangzNative.validationDebounceMs": {
          "type": "number",
          "default": 100,
          "minimum": 20,
          "maximum": 2000,
          "description": ".native 文件发生修改后，延迟多少毫秒开始校验。"
        },
        "tiangzNative.maxFileSizeBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 65536,
          "maximum": 16777216,
          "description": "语言服务器允许解析的单个 .native 文件最大字节数。"
        },
        "tiangzNative.maxDiagnosticsPerFile": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 2000,
          "description": "单个文件最多发布多少条诊断，避免错误风暴拖慢 Problems 面板。"
        },
        "tiangzNative.initialFileLimit": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "maximum": 100000,
          "description": "扫描工作区时最多索引多少个 .native 文件。"
        },
        "tiangzNative.sourceRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "包含权威 .native 源码的工作区相对目录。留空时索引整个工作区；修改后请重新加载 VS Code 窗口。"
        },
        "tiangzNative.codegenCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "执行“TiangZ Native：运行代码生成”时使用的 Shell 命令。留空时禁用代码生成。"
        },
        "tiangzNative.codegenWorkingDirectory": {
          "type": "string",
          "default": ".",
          "scope": "resource",
          "description": "Native 代码生成任务使用的工作区相对工作目录。"
        }
      }
    }
  }
}
