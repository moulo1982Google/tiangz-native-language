{
  "name": "tiangz-native-language",
  "displayName": "TiangZ Native Language",
  "description": "Language support for the TiangZ .native entity and native-op schema",
  "version": "0.4.2",
  "publisher": "moulo",
  "author": "moulo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "onLanguage:tiangz-native"
  ],
  "main": "./dist/extension.cjs",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "TiangZ",
    "native",
    "entity",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/eblard_admin/tiangz-native-language.git"
  },
  "files": [
    "language-configuration.json",
    "syntaxes/**",
    "snippets/**",
    "dist/extension.cjs",
    "dist/extension.cjs.map",
    "dist/server.cjs",
    "dist/server.cjs.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../tools/build-extension.mjs",
    "check:package": "vsce ls --no-dependencies",
    "prepackage": "node -e \"require('node:fs').mkdirSync('../dist', { recursive: true })\"",
    "package": "npm run build && vsce package --no-dependencies --out ../dist/tiangz-native-language-0.4.2.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.6.2",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "contributes": {
    "languages": [
      {
        "id": "tiangz-native",
        "aliases": [
          "TiangZ Native",
          "tiangz-native"
        ],
        "extensions": [
          ".native"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tiangz-native",
        "scopeName": "source.tiangz-native",
        "path": "./syntaxes/tiangz-native.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tiangz-native",
        "path": "./snippets/tiangz-native.json"
      }
    ],
    "commands": [
      {
        "command": "tiangzNative.showServerStats",
        "title": "TiangZ Native: Show Language Server Stats"
      }
    ],
    "configuration": {
      "title": "TiangZ Native",
      "properties": {
        "tiangzNative.validationDebounceMs": {
          "type": "number",
          "default": 100,
          "minimum": 20,
          "maximum": 2000,
          "description": "Delay before validating changed .native files."
        },
        "tiangzNative.maxFileSizeBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 65536,
          "maximum": 16777216,
          "description": "Maximum .native file size parsed by the language server."
        },
        "tiangzNative.maxDiagnosticsPerFile": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 2000,
          "description": "Maximum diagnostics published for one file."
        },
        "tiangzNative.initialFileLimit": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum .native files indexed during workspace discovery."
        },
        "tiangzNative.sourceRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Workspace-relative directories containing authoritative .native sources. Empty indexes the whole workspace. Reload VS Code after changing this setting."
        }
      }
    }
  }
}
