{
  "name": "tiangz-native-language",
  "displayName": "TiangZ Native Language",
  "description": "Language support for the TiangZ .native entity and native-op schema",
  "version": "0.1.0",
  "publisher": "eblard-admin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "TiangZ",
    "native",
    "entity",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/eblard_admin/tiangz-native-language.git"
  },
  "files": [
    "language-configuration.json",
    "syntaxes/**",
    "snippets/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "vsce ls --no-dependencies",
    "prepackage": "node -e \"require('node:fs').mkdirSync('../dist', { recursive: true })\"",
    "package": "vsce package --no-dependencies --out ../dist/tiangz-native-language-0.1.0.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "tiangz-native",
        "aliases": [
          "TiangZ Native",
          "tiangz-native"
        ],
        "extensions": [
          ".native"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tiangz-native",
        "scopeName": "source.tiangz-native",
        "path": "./syntaxes/tiangz-native.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tiangz-native",
        "path": "./snippets/tiangz-native.json"
      }
    ]
  }
}
