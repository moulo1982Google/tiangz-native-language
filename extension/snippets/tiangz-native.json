{
  "命名空间": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:demo};"
    ],
    "description": "声明 TiangZ Native 命名空间"
  },
  "实体": {
    "prefix": "entity",
    "body": [
      "@typeId(${1:1})",
      "entity ${2:Name} extends ${3:Entity} {",
      "  ${4:value}: ${5:u32} = ${6:0};",
      "}"
    ],
    "description": "声明 Native Entity"
  },
  "Component 实体": {
    "prefix": "component",
    "body": [
      "@typeId(${1:1})",
      "@component",
      "entity ${2:Name} extends ${3:Entity} {",
      "  ${4:value}: ${5:u32} = ${6:0};",
      "}"
    ],
    "description": "声明 Native Component Entity"
  },
  "Native 操作": {
    "prefix": "op",
    "body": [
      "op ${1:Operation}(${2:value}: ${3:u32}): ${4:void};"
    ],
    "description": "声明 Native Host 操作"
  },
  "热字段": {
    "prefix": "hot",
    "body": [
      "@hot",
      "${1:value}: ${2:f32} = ${3:0};"
    ],
    "description": "声明进入Rust高频批处理工作集的字段"
  },
  "冷字段": {
    "prefix": "cold",
    "body": [
      "@cold",
      "${1:value}: ${2:u32} = ${3:0};"
    ],
    "description": "声明不进入高频扫描工作集的低频字段"
  }
}
